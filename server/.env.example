# Server Configuration
PORT=5000

# Database Configuration (MongoDB)
# Local MongoDB URI:
MONGO_URI=mongodb://localhost:27017/manxel

# MongoDB Atlas URI Example (if using cloud database):
# MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/manxel?retryWrites=true&w=majority

# Gmail Email Notifications (Nodemailer)
# 1. EMAIL_USER: Your Gmail address (e.g. yourname@gmail.com)
# 2. EMAIL_PASS: Google App Password (Generate from: Google Account -> Security -> 2-Step Verification -> App Passwords)
# 3. ADMIN_EMAIL: The destination Gmail address to receive lead alerts (defaults to EMAIL_USER if omitted)
EMAIL_USER=
EMAIL_PASS=
ADMIN_EMAIL=
